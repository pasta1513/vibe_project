# server/.env의 예시입니다. (README "진짜 AI 연결", D-004)
# 이 파일을 복사해 server/.env를 만들고 키를 채웁니다. 키는 이 예시 파일에 적지 않습니다.

# AI 고르기: bedrock이면 진짜 AI, fake이거나 없으면 가짜 AI (D-013)
AI_PROVIDER=fake

# Bedrock API 키 (AWS 콘솔에서 사람이 직접 만들어 넣음)
AWS_BEARER_TOKEN_BEDROCK=

# Bedrock을 부르는 리전과 모델. 적지 않으면 아래 값을 씁니다.
AWS_REGION=ap-northeast-2
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0

# 추천의 "전문가" 페르소나에만 쓰는 모델. 비우면 전문가도 BEDROCK_MODEL_ID를 씁니다. (D-020)
# 예: apac.anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MODEL_ID2=

# 날씨 고르기: openweathermap이면 진짜(무료 5 Day / 3 Hour Forecast), fake이거나 없으면 가짜 (D-014)
WEATHER_PROVIDER=fake

# 날씨에 쓸 OpenWeatherMap 키 (WEATHER_PROVIDER=openweathermap일 때)
OPENWEATHERMAP_API_KEY=

# 저장 폴더. 적지 않으면 data/ 입니다. 개발 서버는 data-dev를 씁니다. (D-017, D-018)
# DATA_DIR=data-dev
