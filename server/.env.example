# server/.env의 예시입니다. (README "진짜 AI 연결", D-004, D-013)
# 이 파일을 복사해 server/.env를 만들고 키를 채웁니다. 키는 이 예시 파일에 적지 않습니다.

# AI 고르기: bedrock이면 진짜 AI(Amazon Nova Lite), fake이거나 없으면 가짜 AI
AI_PROVIDER=fake

# Bedrock API 키 (AWS 콘솔에서 사람이 직접 만들어 넣음)
AWS_BEARER_TOKEN_BEDROCK=

# Bedrock을 부르는 리전과 모델. 적지 않으면 아래 값을 씁니다.
AWS_REGION=ap-northeast-2
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0

# 날씨에 쓸 키. 날씨는 아직 가짜라서 지금은 쓰지 않습니다.
OPENWEATHERMAP_API_KEY=
